# ============================================================
#  RK Electronics — Environment Template (no secrets)
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-media

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cloudflare Turnstile (site key only; secret goes in Supabase Auth) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ---- Contact (country code + number, no + or spaces) ----
NEXT_PUBLIC_CONTACT_WHATSAPP=91XXXXXXXXXX
