# ============================================================
#  RK Electronics — Environment Template (no secrets)
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-media

# Personal access token for admin dashboard quota (egress, DB, storage). Server-only.
# Create at supabase.com/dashboard/account/tokens — must start with sbp_ (not anon/service keys).
SUPABASE_ACCESS_TOKEN=
# Optional; parsed from NEXT_PUBLIC_SUPABASE_URL when unset
SUPABASE_PROJECT_REF=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cloudflare Turnstile (site key only; secret goes in Supabase Auth) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ---- Cron (Vercel sends Authorization: Bearer CRON_SECRET) ----
CRON_SECRET=generate_a_long_random_string

# ---- Data source (same app; only storage switches) ----
# false = Supabase (production). true = local fixtures/demo-catalog.json
NEXT_PUBLIC_DEMO_MODE=false

# ---- Free-tier media limits (optional; defaults shown) ----
# Square WebP edge length in pixels (200–2000)
NEXT_PUBLIC_IMAGE_MAX_EDGE=600
# WebP quality 0.3–1.0
NEXT_PUBLIC_IMAGE_WEBP_QUALITY=0.65
# Max images per product (1–20)
NEXT_PUBLIC_PRODUCT_MAX_IMAGES=2
# Max characters for description / defect notes
NEXT_PUBLIC_DESCRIPTION_MAX_LENGTH=500
NEXT_PUBLIC_DEFECT_NOTES_MAX_LENGTH=300
